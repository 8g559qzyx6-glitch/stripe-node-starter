# Copy to .env and fill in. Never commit .env.
# Restricted test key (rk_test_...) from your sandbox. Needs write access to Checkout Sessions.
STRIPE_API_KEY=rk_test_replace_me
# Printed by `npm run listen` (stripe listen) — starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_replace_me
DOMAIN=http://localhost:4242
PORT=4242
